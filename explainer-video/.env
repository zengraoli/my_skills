# explainer-video 配置：直接改这个文件即可。优先级：命令行参数 > 系统环境变量 > .env > 内置默认值
SENSEAUDIO_API_KEY=sk-2NBWHIa5ybUOeuaya2IXPs2RQlNtCd6HA28984A1CaFb42C0B691Ac3f9810Ef8d

# SenseAudio TTS
TTS_BASE_URL=https://api.senseaudio.cn/v1
TTS_MODEL=sensenova-tts-2.0
# 默认音色：female_0038_b 亲切女孩·温柔讲解版
# 男声可用 male_0029_a（利落青年）、male_0004_a（儒雅道长）
# 音色 id 末位 a-f 是同一音色的不同情绪版本，完整表与试听：https://docs.senseaudio.cn/guides/voice/catalog
TTS_VOICE=female_0038_b
TTS_SPEED=1.05

# 工具路径
# ffmpeg：Windows 从 https://www.gyan.dev/ffmpeg/builds/ 下载 zip 解压，把解压后的 bin 目录填在这里
#         （填 ffmpeg.exe 的完整路径也可以）；已加入 PATH 的可以留空
FFMPEG_DIR=C:\soft\ffmpeg-2026-08-09\bin
# Chrome：装在默认位置留空即可自动探测；否则填 chrome.exe 完整路径
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
