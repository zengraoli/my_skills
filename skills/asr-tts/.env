# asr-tts 配置：直接改这个文件。优先级：命令行参数 > 系统环境变量 > .env > 内置默认值
SENSEAUDIO_API_KEY=sk-TZewZIdMxcAEpL6ihfiZv5knPuMzfcyz0d7d94Ed53994300986f1b8d408b776b

# 语音识别默认模型：lite / standard / pro / deepthink
#   standard（1.8 元/小时）：逐字 + 逐句时间戳、标点 —— 提歌词、出字幕用它
#   pro（3.6 元/小时）：再加说话人区分、翻译
#   lite（0.9 元/小时）：只有文字，支持热词
#   deepthink（3.6 元/小时）：会把口语改写成书面语，**不适合提歌词**
ASR_MODEL=standard

# 文字转语音：senseaudio（3.5 元/万字符，汉字算 2 字符）或 edge（免费、无需 key）
TTS_PROVIDER=senseaudio
TTS_VOICE=female_0038_b
EDGE_VOICE=zh-CN-XiaoxiaoNeural
TTS_SPEED=1.0

# ffmpeg 不在 PATH 时填 bin 目录
FFMPEG_DIR=C:\soft\ffmpeg-2026-08-09\bin
