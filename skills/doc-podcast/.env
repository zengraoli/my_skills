# doc-podcast 配置：直接改这个文件。优先级：命令行参数 > 系统环境变量 > .env > 内置默认值
SENSEAUDIO_API_KEY=sk-TZewZIdMxcAEpL6ihfiZv5knPuMzfcyz0d7d94Ed53994300986f1b8d408b776b

# 音频生成模型（0.017 元/秒，单次最长 120 秒，脚本自动分段）
AUDIO_MODEL=senseaudio-a1
# 每段最多字数（实测约 4.7 字/秒，450 字 ≈ 95 秒，留出余量）
CHUNK_CHARS=450
# 段与段之间的静音秒数
CHUNK_GAP=0.5

# 推荐主播音色（完整表与试听 https://docs.senseaudio.cn/guides/voice/catalog）
# 女：female_0038_b 亲切女孩·温柔讲解  female_0036_a 青春女声·内容剖析
# 男：male_0029_a 利落青年·内容剖析    male_0004_a 儒雅道长

# ffmpeg 不在 PATH 时填 bin 目录
FFMPEG_DIR=C:\soft\ffmpeg-2026-08-09\bin
