# music-gen 配置：直接改这个文件。优先级：命令行参数 > 系统环境变量 > .env > 内置默认值
SENSEAUDIO_API_KEY=sk-3Fnynl25bdNImnXbwJq8t7vVTYFlamuK4259477a220248909d80F6630f5bA166

# 音乐模型（0.5 元/首，与时长无关）
MUSIC_MODEL=senseaudio-music-2.0-260626
# 开场致谢独白用的 TTS 音色（音色表 https://docs.senseaudio.cn/guides/voice/catalog）
TTS_MODEL=sensenova-tts-2.0
TTS_VOICE=female_0038_b
# 测人声起始用的 ASR 模型
ASR_MODEL=senseaudio-asr-1.5-260319

# ffmpeg 不在 PATH 时填 bin 目录（Windows 从 https://www.gyan.dev/ffmpeg/builds/ 下载解压）
FFMPEG_DIR=C:\soft\ffmpeg-2026-08-09\bin
