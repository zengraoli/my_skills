# suno-music 配置：直接改这个文件。优先级：命令行参数 > 系统环境变量 > .env > 内置默认值

# 走哪家 Suno 中转：ttapi（推荐，v6 + 全功能）或 t8star（只支持基础生成，最高 v5）
SUNO_PROVIDER=ttapi

# TTAPI（https://ttapi.io 注册，鉴权头是 TT-API-KEY，100 quota = $1）
TTAPI_KEY=sk-tt-api-GaQ81JZUcI8K0xnYQZsOX7II9p
TTAPI_BASE=https://api.ttapi.io

# t8star（https://ai.t8star.org ，฿0.5/次 ≈ ¥0.68，最高 chirp-v5）
T8STAR_KEY=sk-guj1MWxyeeO81E7htQqnOXXhHSJ9j1nrpvUcwbHWsX8kbshS
T8STAR_BASE=https://ai.t8star.org

# 模型：chirp-v6（默认）/ chirp-v6-wild（更放飞）/ chirp-v6-mini（更快）
SUNO_MODEL=chirp-v6

# 开场独白用的 TTS：edge（免费、无需 key，默认）或 senseaudio（需下方 key）
INTRO_TTS=edge
EDGE_VOICE=zh-CN-XiaoxiaoNeural
# 男声可用 zh-CN-YunxiNeural；更多音色：edge-tts --list-voices

# 可选：用 SenseAudio 做独白时才需要（音色表 https://docs.senseaudio.cn/guides/voice/catalog）
SENSEAUDIO_API_KEY=
SENSEAUDIO_VOICE=female_0038_b

# 产物与本地库目录（歌曲 mp3、library.json 都在这里）
OUT_DIR=output/suno

# ffmpeg 不在 PATH 时填 bin 目录
FFMPEG_DIR=C:\soft\ffmpeg-2026-08-09\bin
